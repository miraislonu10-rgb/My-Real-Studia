{
  "name": "studia",
  "version": "0.1.0",
  "private": true,
  "description": "STUDIA - Monorepositorio: frontend React + backend Node.js/Express + base de datos MySQL",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm run test --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "hash:password": "npm run hash:password --prefix backend --"
  },
  "keywords": [
    "studia",
    "react",
    "express",
    "mysql",
    "monorepo"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
