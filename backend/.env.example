# ---------------------------------------------------------------------------
# STUDIA Backend - variables de entorno
# Copia este archivo como .env y ajusta los valores.
#   PowerShell:  Copy-Item .env.example .env
# El archivo .env NUNCA debe subirse a Git (ya esta en .gitignore).
#
# ATAJO: puedes empezar SIN editar nada. En desarrollo, si dejas vacios los
# secretos JWT y los limites, el servidor genera secretos efimeros y aplica
# limites laxos automaticamente. Solo falta tener MySQL en marcha y la base
# importada (backend/database/studia_database.sql).
# ---------------------------------------------------------------------------

# --- Servidor ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# Origenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
# URL del frontend: se usa para construir los enlaces de recuperacion
FRONTEND_URL=http://localhost:5173
# Politica de la cookie de sesion: lax en local (mismo sitio) y none cuando el
# frontend vive en otro dominio (Vercel + Render). Por defecto ya se elige
# automaticamente segun NODE_ENV; descomenta solo para forzarlo.
# COOKIE_SAME_SITE=none
# Proxies de confianza por delante del servidor (Render/Railway/Vercel usan 1)
# TRUST_PROXY=1

# --- Base de datos (XAMPP / MariaDB) ---
# En una instalacion por defecto de XAMPP el usuario root no tiene password.
# Define un DB_PASSWORD propio si le pusiste clave a root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=studia_db
DB_CONNECTION_LIMIT=10

# --- Autenticacion (JWT) ---
# En PRODUCCION es obligatorio definirlos con valores largos y aleatorios.
# En DESARROLLO, si los dejas vacios, el servidor genera secretos efimeros
# (las sesiones se cierran al reiniciar). Genera los tuyos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vigencia del token de acceso (15m, 1h...): corta para limitar el daño de un robo
JWT_EXPIRES_IN=15m
# Secreto independiente para hashear (HMAC-SHA256) los tokens de refresco
JWT_REFRESH_SECRET=
# Vigencia del token de refresco / de la sesion
JWT_REFRESH_EXPIRES_IN=7d
# Coste del hashing bcrypt (10-12 es un valor recomendado)
BCRYPT_SALT_ROUNDS=12
# Longitud minima de contraseña
MIN_PASSWORD_LENGTH=8

# --- Recuperacion de contraseña ---
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- Limite de peticiones (proteccion contra fuerza bruta) ---
# Si los dejas sin definir, en DESARROLLO se aplican limites laxos (1000 general
# / 100 en auth) para no bloquear las pruebas; en PRODUCCION se aplican los
# estrictos (100 / 10). Descomenta y fija aqui un valor para forzarlo en cualquier
# entorno.
# Limite general de toda la API
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# Limite especifico de los endpoints de autenticacion
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

# --- Correo (recuperacion de contraseña) ---
# console = escribe el correo en la consola (ideal en desarrollo, no requiere nada)
# smtp    = envio real (requiere: npm install nodemailer y los datos SMTP)
MAIL_TRANSPORT=console
MAIL_FROM=STUDIA <no-responder@studia.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Cuenta de administrador (solo para el script create:admin) ---
# Se usan si no se pasan por linea de comandos. No se guardan en texto plano:
# el script calcula el hash bcrypt antes de insertar.
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=

# --- STUDIA AI Companion (Inteligencia Artificial) ---
# La integracion es REAL: el backend actua como pasarela y las claves viven
# UNICAMENTE aqui (nunca se exponen al frontend).
# Deja AMBAS vacias para operar con el motor pedagogico local de STUDIA; el
# asistente lo informara de forma transparente, sin simular una IA real.
# Proveedor Google Gemini (recomendado):
# Crea una clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Proveedor compatible con OpenAI (alternativa):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Permite apuntar a un proveedor compatible con la API de OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1
# Tiempo maximo de espera de la API externa (ms) antes de usar el respaldo local.
AI_TIMEOUT_MS=20000
