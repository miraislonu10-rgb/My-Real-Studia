# ---------------------------------------------------------------------------
# STUDIA Backend - variables de entorno
# Copia este archivo como .env y ajusta los valores.
#   PowerShell:  Copy-Item .env.example .env
# El archivo .env NUNCA debe subirse a Git (ya esta en .gitignore).
# ---------------------------------------------------------------------------

# --- Servidor ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# Origenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (XAMPP / MariaDB) ---
# En una instalacion por defecto de XAMPP el usuario root no tiene password.
# Define un DB_PASSWORD propio si le pusiste clave a root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=studia_db
DB_CONNECTION_LIMIT=10

# --- Autenticacion (JWT) ---
# Genera valores largos y aleatorios. No compartas estos secretos.
JWT_SECRET=cambia_este_valor_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambia_este_valor_por_otra_cadena_larga_y_aleatoria
JWT_REFRESH_EXPIRES_IN=7d
# Coste del hashing bcrypt (10-12 es un valor recomendado)
BCRYPT_SALT_ROUNDS=12

# --- Limite de peticiones (proteccion basica contra fuerza bruta) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
