# ---------------------------------------------------------------------------
# STUDIA Frontend - variables de entorno
# Copia este archivo como .env y ajusta los valores.
#   PowerShell:  Copy-Item .env.example .env
# Solo las variables con prefijo VITE_ son visibles en el navegador.
# ---------------------------------------------------------------------------

# URL base de la API del backend (debe terminar incluyendo el prefijo /api)
VITE_API_URL=http://localhost:4000/api

# En produccion (Vercel) se define como variable de entorno del proyecto:
#   VITE_API_URL=/api                     -> la API llega por el proxy de vercel.json (recomendado)
#   VITE_API_URL=https://tu-api.onrender.com/api  -> llamada directa al backend

# Nombre visible de la aplicacion
VITE_APP_NAME=MY REAL STUDIA

# Entorno de ejecucion
VITE_APP_ENV=development
