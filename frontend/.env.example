# ---------------------------------------------------------------------------
# STUDIA Frontend - variables de entorno
# Copia este archivo como .env y ajusta los valores.
#   PowerShell:  Copy-Item .env.example .env
# Solo las variables con prefijo VITE_ son visibles en el navegador.
# ---------------------------------------------------------------------------

# URL base de la API del backend (debe terminar incluyendo el prefijo /api)
VITE_API_URL=http://localhost:4000/api

# Nombre visible de la aplicacion
VITE_APP_NAME=STUDIA

# Entorno de ejecucion
VITE_APP_ENV=development
